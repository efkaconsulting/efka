---
/*
 * The panorama strip that closes every page, sitting directly above the footer.
 *
 * The supplied source is 1224x352 after cropping off the bar that had the
 * domain and email burned into it; the footer carries both already. That width
 * is modest for a full-bleed band, so the image is anchored to the centre and
 * cropped by the viewport rather than stretched: on a wide display the edges
 * are trimmed instead of the whole picture going soft.
 *
 * A gold hairline above and the navy ground below tie it into the page's
 * band rhythm, and the gradient at the bottom hands off to the footer without
 * a hard edge.
 */
import { Image } from 'astro:assets';
import banner from '~/assets/images/banner.webp';

interface Props {
  alt?: string;
  class?: string;
}

const { alt = '', class: className = '' } = Astro.props;
---

<div class:list={['brand-seam bg-navy relative overflow-hidden', className]}>
  <Image
    src={banner}
    alt={alt}
    widths={[612, 1224]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="h-40 w-full object-cover object-center md:h-56 lg:h-64"
  />

  <!-- Fades the photograph into the footer below it. -->
  <div
    class="from-page dark:from-dark absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t to-transparent"
    aria-hidden="true"
  >
  </div>
</div>
