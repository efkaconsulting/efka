---
/*
 * Slim strip above the header.
 *
 * Replaces AstroWind's template announcement. Currently carries the
 * under-construction notice; once the site launches, swap `notice` for a
 * standing line (scarcity, seasonal availability) or remove this widget from
 * PageLayout.astro entirely.
 */
const notice = 'Bu site yapım aşamasındadır — içerikler kısa süre içinde güncellenecektir.';
const email = 'info@efkaconsulting.com';
---

<div
  class="relative hidden overflow-hidden border-b border-gold/25 bg-navy px-4 py-2 text-ellipsis whitespace-nowrap text-ivory/70 md:flex md:items-center md:gap-3"
>
  <span class="brand-eyebrow text-[0.65rem]">Yapım Aşamasında</span>

  <span class="h-3 w-px bg-gold/40" aria-hidden="true"></span>

  <span class="font-sans text-xs font-light">{notice}</span>

  <a
    href={`mailto:${email}`}
    class="font-sans text-xs font-light tracking-[0.08em] transition ltr:ml-auto rtl:mr-auto hover:text-gold"
  >
    {email}
  </a>
</div>
