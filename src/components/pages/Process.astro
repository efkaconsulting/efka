---
/*
 * Process page: the six stages, as a timeline.
 */
import Layout from '~/layouts/PageLayout.astro';

import BandBg from '~/components/brand/BandBg.astro';
import SeamMedallion from '~/components/brand/SeamMedallion.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { useContent } from '~/i18n/content';
import type { Lang } from '~/i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const c = useContent(lang);
const t = c.process;

// The document numbers the stages 1 to 6. The timeline conveys the order, and
// the number is kept in the heading so the page still matches the document.
const steps = t.steps.map((step, i) => ({
  ...step,
  title: `<span class="text-gold mr-2 font-heading">${i + 1}</span>${step.title}`,
}));
---

<Layout metadata={t.meta} lang={lang}>
  <!-- Sürecimiz — NAVY (first band, no seam above) ******************** -->

  <div class="dark">
    <Hero tagline={t.hero.tagline} subtitle={t.hero.subtitle}>
      <Fragment slot="bg">
        <BandBg tone="navy" seam={false} />
      </Fragment>

      <Fragment slot="title">
        <span class="text-heading">{t.hero.title}</span>
      </Fragment>

      <Fragment slot="content">
        <hr class="brand-rule mx-auto mt-14 w-40 opacity-70" />
      </Fragment>
    </Hero>
  </div>

  <SeamMedallion tone="navy" />

  <!-- The six stages — IVORY ****************************************** -->

  <Steps items={steps}>
    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Steps>

  <!-- Süreç Hakkında Görüşün — NAVY *********************************** -->

  <CallToAction isDark title={c.contact.hero.title} subtitle={c.contact.hero.subtitle} actions={[t.cta]}>
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </CallToAction>
</Layout>
