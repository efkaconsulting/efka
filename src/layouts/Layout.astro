---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

import { DEFAULT_LOCALE, LOCALE_HTML_LANG, PATH_ALTERNATES, langOf, localePath } from '~/i18n/routes';
import type { Lang } from '~/i18n/routes';

export interface Props {
  metadata?: MetaDataType;
  /** Locale of the page. Defaults to the locale the URL belongs to. */
  lang?: Lang;
}

const pathname = new URL(Astro.url).pathname;

const { metadata = {}, lang = langOf(pathname) } = Astro.props;
const { textDirection } = I18N;

// hreflang alternates, so each page declares its counterpart in the other
// locale rather than leaving search engines to guess they are translations.
const alternates = PATH_ALTERNATES[pathname.replace(/\/+$/, '') || '/'];
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[lang]} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-montserrat" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    {
      alternates &&
        Object.entries(alternates).map(([code, path]) => (
          <link rel="alternate" hreflang={code} href={new URL(path, Astro.site)} />
        ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('home', DEFAULT_LOCALE), Astro.site)} />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <Intersect />
  </body>
</html>
