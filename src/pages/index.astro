---
/*
 * efka consulting — home page.
 *
 * Composition only. Every string lives in `~/data/home/content`; this file
 * decides band order and layout.
 *
 * BAND RHYTHM — the page alternates deep navy and ivory full-bleed sections,
 * separated by a gold hairline seam. Each section pairs two things:
 *
 *   isDark          → flips AstroWind's text tokens and `dark:` variants
 *   <BandBg tone /> → paints the ground and draws the seam
 *
 * Keep them in sync (isDark ⇔ tone="navy") and keep the tones alternating.
 * No widget is forked to achieve this.
 */
import Layout from '~/layouts/PageLayout.astro';

import BandBg from '~/components/brand/BandBg.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { meta, hero, services, process, about, stats, testimonials, faqs, journal, contact } from '~/data/home/content';
---

<Layout metadata={meta}>
  <!-- Hero — NAVY (first band, so no seam above it) ******************** -->

  <div class="dark">
    <Hero tagline={hero.tagline} actions={hero.actions}>
      <Fragment slot="bg">
        <BandBg tone="navy" seam={false} />
      </Fragment>

      <Fragment slot="title">
        <span class="text-heading" set:html={hero.title} />
      </Fragment>

      <Fragment slot="subtitle">
        <span set:html={hero.subtitle} />
      </Fragment>

      <Fragment slot="content">
        <hr class="brand-rule mx-auto mt-14 w-40 opacity-70" />
      </Fragment>
    </Hero>
  </div>

  <!-- Hizmetler — IVORY *********************************************** -->

  <Features
    id="hizmetler"
    tagline={services.tagline}
    title={services.title}
    subtitle={services.subtitle}
    items={services.items}
  >
    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Features>

  <!-- Sürecimiz — NAVY ************************************************ -->

  <Steps
    isDark
    id="surec"
    tagline={process.tagline}
    title={process.title}
    subtitle={process.subtitle}
    items={process.items}
  >
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </Steps>

  <!-- Hakkımızda — IVORY ********************************************** -->

  <Content id="hakkimizda" tagline={about.tagline} title={about.title} items={about.items} image={about.image}>
    <Fragment slot="content">
      <p class="text-muted font-serif text-2xl leading-relaxed italic">{about.intro}</p>
      <hr class="brand-rule mt-6 w-24 opacity-80" />
    </Fragment>

    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Content>

  <!-- Referanslar — NAVY ********************************************** -->

  <Testimonials
    isDark
    id="referanslar"
    tagline={testimonials.tagline}
    title={testimonials.title}
    subtitle={testimonials.subtitle}
    testimonials={testimonials.items}
  >
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </Testimonials>

  <!-- Rakamlarla — IVORY ********************************************** -->

  <Stats stats={stats}>
    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Stats>

  <!-- SSS — NAVY ****************************************************** -->

  <FAQs
    isDark
    id="sss"
    tagline={faqs.tagline}
    title={faqs.title}
    items={faqs.items}
    classes={{ container: 'max-w-6xl' }}
  >
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </FAQs>

  <!-- Günlük — IVORY ************************************************** -->

  <BlogLatestPosts title={journal.title} information={journal.information} linkText="Tüm yazılar">
    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </BlogLatestPosts>

  <!-- İletişim — NAVY ************************************************* -->

  <CallToAction isDark id="iletisim" tagline={contact.tagline} actions={contact.actions}>
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>

    <Fragment slot="title">{contact.title}</Fragment>
    <Fragment slot="subtitle">{contact.subtitle}</Fragment>
  </CallToAction>
</Layout>
