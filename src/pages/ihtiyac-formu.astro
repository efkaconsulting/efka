---
/*
 * Household worker client requirements form, sent to clients as a link.
 *
 * Deliberately unlisted: nothing on the site links here, the sitemap filter
 * in astro.config.ts leaves it out, and the page asks search engines not to
 * index it. Anyone who has the URL can still open it and submit.
 *
 * Questions come from src/data/clientForm.ts. Submissions go to a Google Apps
 * Script web app that appends a row to a Google Sheet and emails the answers;
 * see docs/client-form/SETUP.md.
 */
import Layout from '~/layouts/PageLayout.astro';

import BandBg from '~/components/brand/BandBg.astro';
import SeamMedallion from '~/components/brand/SeamMedallion.astro';
import Hero from '~/components/widgets/Hero.astro';

import { clientForm as f, CLIENT_FORM_ENDPOINT, TURNSTILE_SITE_KEY } from '~/data/clientForm';
import type { Bilingual, Field } from '~/data/clientForm';

const metadata = { ...f.meta, robots: { index: false, follow: false } };

// " · " rather than " / ", which many of the labels already contain.
const both = (t: Bilingual) => (t.en === t.tr ? t.en : `${t.en} · ${t.tr}`);
// Turkish first, as everywhere on the page.
const trEn = (t: Bilingual) => (t.en === t.tr ? t.tr : `${t.tr} · ${t.en}`);

// Validation messages for the browser's bubbles, read by the script below.
const messages = Object.fromEntries(Object.entries(f.messages).map(([k, t]) => [k, trEn(t)]));

// `text` is what the drop-down shows (it is narrow); `label` is what the sheet records.
const ageOptions = [
  { value: 'under1', text: '< 1', label: f.ages.underOne.tr },
  ...Array.from({ length: 17 }, (_, i) => ({ value: String(i + 1), text: String(i + 1), label: String(i + 1) })),
  { value: '18+', text: '18+', label: '18+' },
];

const control =
  'block border border-gold/40 bg-white/70 px-4 py-3 text-base text-default transition placeholder:text-muted/70 focus:border-gold focus:ring-2 focus:ring-gold/30 focus:outline-none disabled:opacity-40 user-invalid:border-red-700';
const choice = 'size-4 shrink-0 cursor-pointer accent-[var(--color-gold-600)]';

const isText = (field: Field) => ['text', 'email', 'tel', 'number', 'textarea'].includes(field.type);
---

<Layout metadata={metadata} lang="tr">
  <!-- Title — NAVY (first band, no seam above) ************************ -->

  <div class="dark">
    <Hero tagline="EFKA Consulting">
      <Fragment slot="bg">
        <BandBg tone="navy" seam={false} />
      </Fragment>

      <Fragment slot="title">
        <span class="text-heading block">{f.title.tr}</span>
        <span lang="en" class="mt-3 block text-2xl font-normal text-gold-400 md:text-3xl">{f.title.en}</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="block">{f.intro.tr}</span>
        <span lang="en" class="mt-4 block text-base text-slate-400">{f.intro.en}</span>
      </Fragment>

      <Fragment slot="content">
        <hr class="brand-rule mx-auto mt-14 w-40 opacity-70" />
      </Fragment>
    </Hero>
  </div>

  <SeamMedallion tone="navy" />

  <!-- The form — IVORY ************************************************ -->

  <section class="relative">
    <BandBg tone="ivory" />

    <div class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <form
        id="client-form"
        data-endpoint={CLIENT_FORM_ENDPOINT}
        data-messages={JSON.stringify(messages)}
        class="text-default"
      >
        {
          f.sections.map((section) => (
            <fieldset class="mb-14 border-0 p-0">
              <legend class="mb-8 w-full border-b border-gold/40 pb-3">
                <span class="font-heading block text-2xl md:text-3xl">{section.tr}</span>
                <span lang="en" class="text-muted mt-1 block text-sm tracking-wide uppercase">
                  {section.en}
                </span>
              </legend>

              <div class="grid gap-x-6 gap-y-8 md:grid-cols-2">
                {section.fields.map((field) => {
                  const shared = {
                    'data-field': '',
                    'data-key': field.key,
                    'data-type': field.type,
                    // Turkish only: these become the sheet's column headers and the email's labels.
                    'data-label': field.tr,
                    'data-section': section.tr,
                    ...(field.showIf
                      ? {
                          'data-show-if': field.showIf.key,
                          'data-show-if-any': field.showIf.anyOf.join(','),
                          hidden: true,
                        }
                      : {}),
                    ...(field.type === 'ages' ? { 'data-count-from': field.countFrom, hidden: true } : {}),
                    class: field.wide ? 'md:col-span-2' : '',
                  };
                  const required = isText(field) && (field as { required?: boolean }).required;
                  const caption = (
                    <>
                      <span class="block font-medium">
                        {field.tr}
                        {required && (
                          <span class="text-gold-600" title={both(f.required)}>
                            {' '}
                            *
                          </span>
                        )}
                      </span>
                      <span lang="en" class="text-muted block text-sm">
                        {field.en}
                      </span>
                    </>
                  );

                  if (field.type === 'radio' || field.type === 'checkbox') {
                    return (
                      <fieldset {...shared} class:list={[shared.class, 'border-0 p-0']}>
                        <legend class="mb-3">{caption}</legend>
                        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-6">
                          {field.options.map((option) => (
                            <div class="flex flex-col gap-2">
                              <label class="inline-flex cursor-pointer items-center gap-2.5">
                                <input
                                  type={field.type as 'radio' | 'checkbox'}
                                  name={field.key}
                                  value={option.value}
                                  data-label={both(option)}
                                  class={choice}
                                />
                                <span>
                                  {option.tr}
                                  {option.tr !== option.en && (
                                    <span lang="en" class="text-muted text-sm">
                                      {' '}
                                      · {option.en}
                                    </span>
                                  )}
                                </span>
                              </label>
                              {option.detail && (
                                <input
                                  type="text"
                                  name={`${field.key}__${option.value}`}
                                  data-detail-for={option.value}
                                  aria-label={`${both(option)}: ${both(option.detail)}`}
                                  placeholder={trEn(option.detail)}
                                  maxlength="300"
                                  disabled
                                  class:list={[control, 'w-full py-2 text-sm sm:w-64']}
                                />
                              )}
                            </div>
                          ))}
                        </div>
                      </fieldset>
                    );
                  }

                  if (field.type === 'select') {
                    const id = `f-${field.key}`;
                    return (
                      <div {...shared}>
                        <label for={id} class="mb-2 block">
                          {caption}
                        </label>
                        <select id={id} name={field.key} class:list={[control, 'w-full']}>
                          <option value="">{trEn(f.ages.choose)}</option>
                          {field.options.map((option) => (
                            <option value={option.value} data-label={both(option)}>
                              {trEn(option)}
                            </option>
                          ))}
                        </select>
                      </div>
                    );
                  }

                  if (field.type === 'ages') {
                    return (
                      <fieldset {...shared} class:list={[shared.class, 'border-0 p-0']}>
                        <legend class="mb-3">{caption}</legend>
                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                          {Array.from({ length: field.max }, (_, i) => (
                            <div data-age-slot={i} hidden>
                              <label class="text-muted mb-1 block text-sm">
                                {i + 1}. {f.ages.child.tr} ·{' '}
                                <span lang="en">
                                  {f.ages.child.en} {i + 1}
                                </span>
                                <select name={`${field.key}_${i}`} disabled class:list={[control, 'mt-1 w-full']}>
                                  <option value="">{trEn(f.ages.choose)}</option>
                                  {ageOptions.map((age) => (
                                    <option value={age.value} data-label={age.label}>
                                      {age.text}
                                    </option>
                                  ))}
                                </select>
                              </label>
                            </div>
                          ))}
                        </div>
                      </fieldset>
                    );
                  }

                  if (field.type === 'slots') {
                    return (
                      <fieldset {...shared} class:list={[shared.class, 'border-0 p-0']}>
                        <legend class="mb-3">{caption}</legend>
                        <div class="grid gap-4 sm:grid-cols-3">
                          {Array.from({ length: field.count }, (_, i) => (
                            <label class="text-muted block text-sm">
                              {i + 1}. {f.slot.tr} ·{' '}
                              <span lang="en">
                                {f.slot.en} {i + 1}
                              </span>
                              <input
                                type="datetime-local"
                                name={`${field.key}_${i}`}
                                data-slot
                                class:list={[control, 'mt-1 w-full']}
                              />
                            </label>
                          ))}
                        </div>
                        <input
                          type="text"
                          name={`${field.key}_note`}
                          maxlength="300"
                          aria-label={`${both(field)}: ${both(field.note)}`}
                          placeholder={trEn(field.note)}
                          class:list={[control, 'mt-4 w-full']}
                        />
                      </fieldset>
                    );
                  }

                  if (field.type === 'range') {
                    return (
                      <fieldset {...shared} class:list={[shared.class, 'border-0 p-0']}>
                        <legend class="mb-3">{caption}</legend>
                        <div class="flex items-center gap-3">
                          <input
                            type="number"
                            name={`${field.key}Min`}
                            min={field.min}
                            max={field.max}
                            value={field.defaults[0]}
                            inputmode="numeric"
                            aria-label={`${both(field)}: min`}
                            class:list={[control, 'w-24']}
                          />
                          <span class="text-muted">–</span>
                          <input
                            type="number"
                            name={`${field.key}Max`}
                            min={field.min}
                            max={field.max}
                            value={field.defaults[1]}
                            inputmode="numeric"
                            aria-label={`${both(field)}: max`}
                            class:list={[control, 'w-24']}
                          />
                          <span class="text-muted">
                            {field.unit.tr} · <span lang="en">{field.unit.en}</span>
                          </span>
                        </div>
                      </fieldset>
                    );
                  }

                  const id = `f-${field.key}`;
                  // Only text-like fields reach here; Astro's checker loses that narrowing inside the JSX.
                  const text = field as {
                    type: string;
                    autocomplete?: string;
                    placeholder?: Bilingual;
                    min?: number;
                    max?: number;
                  };
                  return (
                    <div {...shared}>
                      <label for={id} class="mb-2 block">
                        {caption}
                      </label>
                      {text.type === 'textarea' ? (
                        <textarea id={id} name={field.key} rows="4" maxlength="3000" class:list={[control, 'w-full']} />
                      ) : (
                        <input
                          id={id}
                          type={text.type as 'text' | 'email' | 'tel' | 'number'}
                          name={field.key}
                          required={required}
                          autocomplete={text.autocomplete ?? 'off'}
                          placeholder={text.placeholder?.tr}
                          maxlength="300"
                          {...(text.type === 'number'
                            ? {
                                min: String(text.min ?? 0),
                                max: text.max ? String(text.max) : undefined,
                                step: '1',
                                inputmode: 'numeric',
                              }
                            : {})}
                          {...(text.type === 'tel' ? { inputmode: 'tel' } : {})}
                          {...(text.type === 'email' ? { pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}' } : {})}
                          class:list={[control, 'w-full']}
                        />
                      )}
                    </div>
                  );
                })}
              </div>
            </fieldset>
          ))
        }

        <!-- Bots fill in every field; people never see this one. -->
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="border-t border-gold/40 pt-10">
          <div class="mt-10 flex flex-col items-center gap-4">
            <!-- Cloudflare Turnstile bot check. Usually invisible; it only shows a
                 checkbox when Cloudflare wants the visitor to confirm. -->
            <div data-turnstile data-sitekey={TURNSTILE_SITE_KEY}></div>
            <button
              type="submit"
              class="btn-primary w-full sm:w-80"
              data-idle={trEn(f.submit)}
              data-busy={trEn(f.sending)}
            >
              {trEn(f.submit)}
            </button>
            <p data-status-verifying hidden role="status" class="text-muted text-center text-sm">
              {f.verifying.tr}
              <span lang="en" class="mt-1 block">{f.verifying.en}</span>
            </p>
            <p data-status-error hidden role="alert" class="text-center text-sm text-red-700">
              {f.error.tr}{' '}
              <a class="underline" href={`mailto:${f.errorEmail}`}>{f.errorEmail}</a>
              <span lang="en" class="mt-1 block">
                {f.error.en}{' '}
                <a class="underline" href={`mailto:${f.errorEmail}`}>{f.errorEmail}</a>
              </span>
            </p>
          </div>

          <div class="text-muted mt-10 space-y-3 text-sm leading-relaxed">
            <p>
              {f.privacy.tr}{' '}
              <a href={f.privacy.href} target="_blank" rel="noopener" class="text-gold-600 underline">
                {f.privacy.linkText.tr}</a
              >{f.privacy.after.tr}
              <span lang="en" class="block">
                {f.privacy.en}{' '}
                <a href={f.privacy.href} target="_blank" rel="noopener" class="text-gold-600 underline">
                  {f.privacy.linkText.en}</a
                >{f.privacy.after.en}
              </span>
            </p>
            <p>
              {f.disclaimer.tr}
              <span lang="en" class="block">{f.disclaimer.en}</span>
            </p>
          </div>
        </div>
      </form>

      <div
        data-status-success
        hidden
        role="status"
        tabindex="-1"
        class="brand-frame scroll-mt-32 px-6 py-14 text-center"
      >
        <p class="font-heading text-2xl md:text-3xl">{f.success.tr}</p>
        <p lang="en" class="text-muted mt-4">{f.success.en}</p>
      </div>
    </div>
  </section>
</Layout>

<!-- Turnstile loads in explicit mode and announces itself, so the form script
     can render the widget whichever of the two finishes first. -->
<script is:inline>
  window.onTurnstileLoad = () => window.dispatchEvent(new Event('turnstile-ready'));
</script>
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad"
  async
  defer></script>

<script>
  interface Turnstile {
    render(container: HTMLElement, options: Record<string, string>): string;
    getResponse(widgetId: string): string | undefined;
    reset(widgetId: string): void;
  }

  interface Answer {
    key: string;
    label: string;
    section: string;
    value: string;
  }

  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const selectedLabel = (select: HTMLSelectElement | null) =>
    select?.value ? (select.selectedOptions[0]?.dataset.label ?? select.value) : '';

  // "2026-10-22T14:00" → "22.10.2026 14:00"
  const formatSlot = (value: string) => {
    const [date, time] = value.split('T');
    const [y, m, d] = date.split('-');
    return `${d}.${m}.${y} ${time}`;
  };

  const collect = (form: HTMLFormElement): Answer[] =>
    Array.from(form.querySelectorAll<HTMLElement>('[data-field]')).map((el) => {
      const { key = '', type, label = '', section = '' } = el.dataset;
      let value: string;

      if (el.hidden) {
        value = '';
      } else if (type === 'radio' || type === 'checkbox') {
        value = Array.from(el.querySelectorAll<HTMLInputElement>(`input[name="${key}"]:checked`))
          .map((input) => {
            const detail = el.querySelector<HTMLInputElement>(`input[name="${key}__${input.value}"]`)?.value.trim();
            return detail ? `${input.dataset.label}: ${detail}` : (input.dataset.label ?? input.value);
          })
          .join(', ');
      } else if (type === 'select') {
        value = selectedLabel(el.querySelector('select'));
      } else if (type === 'ages') {
        value = Array.from(el.querySelectorAll<HTMLSelectElement>('select:enabled'))
          .map(selectedLabel)
          .filter(Boolean)
          .join(', ');
      } else if (type === 'slots') {
        const slots = Array.from(el.querySelectorAll<HTMLInputElement>('input[data-slot]'))
          .map((input) => input.value)
          .filter(Boolean)
          .map(formatSlot);
        const note = el.querySelector<HTMLInputElement>(`input[name="${key}_note"]`)?.value.trim();
        value = [slots.join('; '), note ? `Not: ${note}` : ''].filter(Boolean).join(' · ');
      } else if (type === 'range') {
        const min = el.querySelector<HTMLInputElement>(`input[name="${key}Min"]`)?.value.trim();
        const max = el.querySelector<HTMLInputElement>(`input[name="${key}Max"]`)?.value.trim();
        value = min || max ? `${min || '?'} – ${max || '?'}` : '';
      } else {
        value = el.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')?.value.trim() ?? '';
      }

      return { key, label, section, value };
    });

  const init = () => {
    const form = document.querySelector<HTMLFormElement>('#client-form');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';

    const startedAt = Date.now();
    const endpoint = form.dataset.endpoint ?? '';
    const messages: Record<string, string> = JSON.parse(form.dataset.messages ?? '{}');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = form.querySelector<HTMLElement>('[data-status-error]')!;
    const verifying = form.querySelector<HTMLElement>('[data-status-verifying]')!;
    const success = document.querySelector<HTMLElement>('[data-status-success]')!;

    const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;
    const box = form.querySelector<HTMLElement>('[data-turnstile]')!;
    const sitekey = box.dataset.sitekey ?? '';
    let widgetId: string | undefined;
    if (sitekey) {
      const render = () => {
        widgetId = turnstile()!.render(box, {
          sitekey,
          language: 'tr',
          theme: 'light',
          appearance: 'interaction-only',
        });
      };
      if (turnstile()) render();
      else window.addEventListener('turnstile-ready', render, { once: true });
    }

    // Interview slots start tomorrow.
    const tomorrow = new Date(Date.now() + 86400000);
    const pad = (n: number) => String(n).padStart(2, '0');
    const minSlot = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth() + 1)}-${pad(tomorrow.getDate())}T00:00`;
    form.querySelectorAll<HTMLInputElement>('input[data-slot]').forEach((input) => (input.min = minSlot));

    const show = (el: HTMLElement, visible: boolean) => {
      el.hidden = !visible;
      // Hidden controls are left out of validation and of the answers.
      el.querySelectorAll<Control>('input, select, textarea').forEach((c) => {
        if (!c.dataset.detailFor) c.disabled = !visible;
      });
    };

    const sync = () => {
      // Fields that depend on another answer, e.g. care ages on the role.
      form.querySelectorAll<HTMLElement>('[data-show-if]').forEach((el) => {
        const chosen = Array.from(
          form.querySelectorAll<HTMLInputElement>(`input[name="${el.dataset.showIf}"]:checked`)
        ).map((i) => i.value);
        show(
          el,
          (el.dataset.showIfAny ?? '').split(',').some((v) => chosen.includes(v))
        );
      });

      // One age drop-down per child.
      form.querySelectorAll<HTMLElement>('[data-count-from]').forEach((el) => {
        const raw = form.querySelector<HTMLSelectElement>(`select[name="${el.dataset.countFrom}"]`)?.value ?? '';
        const slots = el.querySelectorAll<HTMLElement>('[data-age-slot]');
        const count = raw === '5+' ? slots.length : Number(raw) || 0;
        el.hidden = count === 0;
        slots.forEach((slot, i) => show(slot, i < count));
      });

      // A detail box ("Other: ____") is only usable while its option is chosen.
      form.querySelectorAll<HTMLInputElement>('input[data-detail-for]').forEach((detail) => {
        const group = detail.closest<HTMLElement>('[data-field]')!;
        const option = group.querySelector<HTMLInputElement>(
          `input[name="${group.dataset.key}"][value="${detail.dataset.detailFor}"]`
        );
        detail.disabled = !option?.checked;
      });
    };
    form.addEventListener('change', sync);
    sync();

    // Checks the browser cannot express with attributes alone.
    const check = (c: Control) => {
      c.setCustomValidity('');
      if (!(c instanceof HTMLInputElement) || !c.value) return;
      if (c.type === 'tel') {
        const digits = c.value.replace(/\D/g, '');
        const ok = /^\+?[\d\s().-]+$/.test(c.value.trim()) && digits.length >= 10 && digits.length <= 15;
        if (!ok) c.setCustomValidity(messages.tel);
      }
      if (c.name.endsWith('Max') || c.name.endsWith('Min')) {
        const base = c.name.replace(/(Min|Max)$/, '');
        const min = form.querySelector<HTMLInputElement>(`input[name="${base}Min"]`);
        const max = form.querySelector<HTMLInputElement>(`input[name="${base}Max"]`);
        if (min && max) {
          max.setCustomValidity(
            min.value && max.value && Number(max.value) < Number(min.value) ? messages.rangeOrder : ''
          );
        }
      }
    };
    form.addEventListener('input', (event) => check(event.target as Control));
    form.addEventListener('change', (event) => check(event.target as Control));

    // Explains in both languages why a field was not accepted.
    form.addEventListener(
      'invalid',
      (event) => {
        const c = event.target as Control;
        if (c.validity.customError) return;
        let message = messages.required;
        if (!c.validity.valueMissing) {
          if (c.type === 'email') message = messages.email;
          else if (c.type === 'datetime-local') message = messages.future;
          else if (c.type === 'number') {
            const input = c as HTMLInputElement;
            message = messages.number.replaceAll('{min}', input.min).replaceAll('{max}', input.max || '…');
          }
        }
        c.setCustomValidity(message);
      },
      true
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      verifying.hidden = true;

      // Without a site key there is no widget, and the script will refuse the
      // submission; the error message below then tells the visitor to email.
      const token = widgetId ? turnstile()?.getResponse(widgetId) : '';
      if (sitekey && !token) {
        verifying.hidden = false;
        return;
      }

      const fields = collect(form);

      button.disabled = true;
      button.textContent = button.dataset.busy ?? '';

      try {
        if (!endpoint) throw new Error('No CLIENT_FORM_ENDPOINT configured');
        // text/plain keeps this a "simple" request, so the browser sends it
        // without a CORS preflight, which Apps Script does not answer.
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({
            fields,
            website: form.querySelector<HTMLInputElement>('input[name="website"]')?.value ?? '',
            elapsedMs: Date.now() - startedAt,
            turnstileToken: token,
          }),
        });
        const result = await response.json();
        if (!result.ok) throw new Error(result.error ?? 'Submission rejected');

        form.hidden = true;
        success.hidden = false;
        success.focus();
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (cause) {
        console.error(cause);
        error.hidden = false;
        // A token can be used only once, so get a fresh one for the next try.
        if (widgetId) turnstile()?.reset(widgetId);
        button.disabled = false;
        button.textContent = button.dataset.idle ?? '';
      }
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
